{
  "name": "Player",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "correct_answers": {
      "type": "number",
      "default": 0
    },
    "current_question_index": {
      "type": "number",
      "default": 0
    },
    "is_ready": {
      "type": "boolean",
      "default": false
    },
    "is_finished": {
      "type": "boolean",
      "default": false
    },
    "finish_time": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_index": {
            "type": "number"
          },
          "answer": {
            "type": "number"
          },
          "is_correct": {
            "type": "boolean"
          },
          "time_ms": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "room_code",
    "player_name"
  ]
}